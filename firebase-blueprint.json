{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Pharmaceutical product in the dispensary catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "genericName": { "type": "string" },
        "category": { "type": "string" },
        "legalCategory": { "type": "string" },
        "basePrice": { "type": "number" },
        "originalPrice": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "strength": { "type": "string" },
        "format": { "type": "string" },
        "activeIngredient": { "type": "string" },
        "badge": { "type": "string" },
        "sku": { "type": "string" },
        "deliveryEstimate": { "type": "string" },
        "prescriptionRequired": { "type": "boolean" },
        "bnfIndication": { "type": "string" },
        "dosageAdult": { "type": "string" },
        "usageInstructions": { "type": "array" },
        "cautions": { "type": "array" },
        "commonSideEffects": { "type": "array" },
        "description": { "type": "string" },
        "packOptions": { "type": "array" },
        "isControlled": { "type": "boolean" }
      },
      "required": ["id", "name", "category", "basePrice", "format", "packOptions"]
    },
    "Order": {
      "title": "Order",
      "description": "Prescription and over-the-counter medicine order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "createdAt": { "type": "number" },
        "date": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "loyaltyDiscount": { "type": "number" },
        "autoRefillDiscount": { "type": "number" },
        "shippingFee": { "type": "number" },
        "shippingMethod": { "type": "string" },
        "total": { "type": "number" },
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "city": { "type": "string" },
        "postcode": { "type": "string" },
        "country": { "type": "string" },
        "deliveryNotes": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "trackingHistory": { "type": "array" },
        "hasAutoRefill": { "type": "boolean" }
      },
      "required": ["id", "createdAt", "customerName", "phone", "deliveryAddress", "postcode", "paymentMethod", "total"]
    },
    "AutoRefill": {
      "title": "AutoRefill",
      "description": "Recurring subscription schedule for medications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "deliveryAddress": { "type": "string" },
        "postcode": { "type": "string" },
        "productName": { "type": "string" },
        "packLabel": { "type": "string" },
        "pricePerRefill": { "type": "number" },
        "intervalDays": { "type": "number" },
        "nextRefillDate": { "type": "string" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "createdDate": { "type": "string" }
      },
      "required": ["id", "customerName", "productName", "intervalDays", "status"]
    },
    "Review": {
      "title": "Review",
      "description": "Verified patient review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "rating": { "type": "number" },
        "date": { "type": "string" },
        "productName": { "type": "string" },
        "title": { "type": "string" },
        "comment": { "type": "string" },
        "verifiedBuyer": { "type": "boolean" },
        "helpfulCount": { "type": "number" }
      },
      "required": ["id", "name", "rating", "comment"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Active shopping cart session",
      "type": "object",
      "properties": {
        "items": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["items"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount voucher code",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountPercent": { "type": "number" },
        "description": { "type": "string" },
        "minSpend": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["code", "discountPercent", "description"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "Digital triage message log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "sender": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "sender", "text", "timestamp"]
    },
    "Category": {
      "title": "Category",
      "description": "Medicine category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Promotional dispensary banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "title"]
    },
    "FAQ": {
      "title": "FAQ",
      "description": "Frequently asked question item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "question", "answer"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "Newsletter email subscriber",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "subscribedAt": { "type": "number" }
      },
      "required": ["id", "email"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Admin activity audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "affectedItem": { "type": "string" },
        "category": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "action", "timestamp"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of all UK pharmaceutical products"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of patient medicine orders"
    },
    "/autoRefills/{refillId}": {
      "schema": "AutoRefill",
      "description": "Scheduled auto-refill subscriptions"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Verified patient dispensary reviews"
    },
    "/carts/{cartId}": {
      "schema": "Cart",
      "description": "Live cloud synchronized cart sessions"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Active promotional discount vouchers"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Medicine categories"
    },
    "/banners/{bannerId}": {
      "schema": "Banner",
      "description": "Store promotional banners"
    },
    "/faqs/{faqId}": {
      "schema": "FAQ",
      "description": "Frequently asked questions"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Newsletter subscribers"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Admin activity audit records"
    },
    "/consultations/{sessionId}": {
      "schema": "Consultation",
      "description": "Digital triage & clinical interaction logs"
    }
  }
}
